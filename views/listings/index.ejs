<% layout("/layouts/boilerplate") %>
<%=success%>
<body>
    <div class="container py-3 px-4">
    <h3>All Listings</h3>
    <!-- <form method="GET" action="/listings/new">
        <button>Create new Listing</button>
        <br><br>
    </form> -->


    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-3 g-3">
        <% for(let listing of allListings){%>
            <div class="col">
                <a href="/listings/<%=listing._id %>" class="listing-link">
                    <div class="card listing-card h-100">
                        <img src="<%=listing.image %>" class="card-img-top" alt="<%=listing.title %>" style="height: 20rem;">
                        <div class="card-body">
                            <h5 class="card-title"><%=listing.title %></h5>
                            <p class="card-text"><%= listing.price.toLocaleString("en-IN") %> /night</p>
                        </div>
                    </div>
                </a>
            </div>
<%}%>
    </div>
    </div>

<!-- 
<% for(let listing of allListings){%>
    <li><a href="/listings/<%=listing._id %>"><%=listing.title %></a></li>
<%}%> -->
</body>
</html>
