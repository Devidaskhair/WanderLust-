<% layout("/layouts/boilerplate") %>

<div class="row">
  <div class="col-8 offset-2">

    <div class="card show-card listing-card">

      <h2><%= listing.title %></h2>

      <img src="<%= listing.image %>" class="card-img-top show-img" alt="...">

      <div class="card-body">

        <p class="card-text">
          <%= listing.description %><br>
          <%= listing.description %><br>
          &#8377;<%= listing.price.toLocaleString("en-IN") %><br>
          <%= listing.location %><br>
          <%= listing.country %>
        </p>
       
        <div class="btns">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
            Edit
          </a>
          

          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-danger">Delete</button>
          </form>
        </div>
     <hr>
        <div class="review mt-4">

          <h4>Leave A Review</h4>

          <form action="/listings/<%= listing._id %>/reviews" 
            method="POST"
            novalidate 
            class="needs-validation"> 
           <div class="mb-3 mt-3">
              <label for="rating" class="form-label">Rating</label>

              <input
                type="range"
                id="rating"
                name="review[rating]"
                min="1"
                max="5"
                class="form-range"
              >
            </div>

            <div class="mb-3 mt-3">
              <label for="comment" class="form-label">Comment</label>

              <textarea
                id="comment"
                name="review[comment]"
                cols="30"
                rows="5"
                class="form-control"
                required
                     
              ></textarea>
               <div class="invalid-feedback">
                Please provide a comment.
                </div>
            </div>

            <button type="submit" class="btn btn-dark">
              Submit Review
            </button>
          </form>
          
            <hr>
          <h4><b>Reviews</b></h4>
          <div class="row">
          <% for(review of listing.reviews){%>
              <div class="card col-5 ms-2 mb-3 ">
                <div class="card-body">
                  <h5 class="card-title">
                    Devidas
                  </h5>
                  <p class="card-text">
                    <%= review.comment %>
                  </p>
                  <p class="card-text">
                    Rating: <%= review.rating %>
                  </p>
                </div>
                <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                  <button class="btn btn-danger  btn-sm mb-3">Delete</button>
              
                </form>

              </div>
             <%}%>
             </div>

        </div> <!-- review -->

       

    
  </div> <!-- card-body -->
       </div> <!-- card -->
  </div> <!-- outer col -->

</div> <!-- row -->